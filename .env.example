# Database
DATABASE_URL=postgresql://privatchat:privatchat@localhost:5432/privatchat
DB_PASSWORD=privatchat

# Security - CHANGE THIS IN PRODUCTION (min 32 chars)
SECRET_KEY=dev-secret-key-change-in-production-min-32-chars!!

# Push Notifications (VAPID keys - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# File Storage
UPLOAD_DIR=./uploads
FILE_RETENTION_DAYS=30
MAX_FILE_SIZE_MB=500

# Frontend
FRONTEND_URL=http://localhost:3000

# Environment (development/production)
ENVIRONMENT=development
