# Liana Configuration
# Скопируйте этот файл в .env и измените значения

# Database
# Для локальной разработки используйте SQLite:
DATABASE_URL=sqlite:///./liana.db
# Для production используйте PostgreSQL:
# DATABASE_URL=postgresql://liana:password@localhost:5432/liana

# Security (ОБЯЗАТЕЛЬНО измените в production!)
# Сгенерируйте: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-min-32-chars!!

# Frontend URL
FRONTEND_URL=http://localhost:3000

# Environment (development/production)
ENVIRONMENT=development

# File Storage
UPLOAD_DIR=./uploads
FILE_RETENTION_DAYS=30
MAX_FILE_SIZE_MB=500

# Push Notifications (VAPID keys)
# Сгенерируйте: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# PostgreSQL (только для Docker/production)
# DB_PASSWORD=liana_secret_password
