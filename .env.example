# Database - MUST CHANGE in production
DB_PASSWORD=your_strong_password_here

# Security - MUST CHANGE in production (min 32 chars)
SECRET_KEY=your_random_secret_key_at_least_32_characters_long

# Push Notifications (VAPID keys - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# File Storage
FILE_RETENTION_DAYS=30
MAX_FILE_SIZE_MB=500

# Frontend URL
FRONTEND_URL=https://chat.example.com
