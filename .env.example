# Database
DATABASE_URL=postgresql://privatchat:privatchat_secret@localhost:5432/privatchat
DB_PASSWORD=privatchat_secret

# Security
SECRET_KEY=change_this_to_a_random_64_char_string_in_production

# Push Notifications (VAPID keys - generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# File Storage
UPLOAD_DIR=./uploads
FILE_RETENTION_DAYS=30
MAX_FILE_SIZE_MB=500

# Frontend
FRONTEND_URL=https://chat.example.com

# Domain
DOMAIN=chat.example.com
